DATABASE_URL=sqlite:///./digital_trust.db
VITE_API_URL=http://localhost:8000/api
GOOGLE_SAFE_BROWSING_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_SAFE_BROWSING_API_URL=https://safebrowsing.googleapis.com/v4/threatMatches:find
GOOGLE_SAFE_BROWSING_TIMEOUT_SECONDS=8
GOOGLE_SAFE_BROWSING_MAX_RETRIES=2
GOOGLE_SAFE_BROWSING_RETRY_BACKOFF_SECONDS=0.2
GOOGLE_SAFE_BROWSING_STATUS_CACHE_SECONDS=300
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3
VIRUSTOTAL_TIMEOUT_SECONDS=10
VIRUSTOTAL_MAX_RETRIES=2
VIRUSTOTAL_RETRY_BACKOFF_SECONDS=0.2
VIRUSTOTAL_CACHE_TTL_SECONDS=900
OTX_API_KEY=
OPSWAT_API_KEY=
# URLhaus is the configured no-key alternative to PhishTank.
URLHAUS_API_URL=https://urlhaus-api.abuse.ch/v1/url/
URLHAUS_AUTH_KEY=
# Leave empty unless a genuine PhishTank endpoint/key is configured.
PHISHTANK_API_URL=
IPINFO_TOKEN=
IP_INTELLIGENCE_PROVIDER=freeipapi
FREEIPAPI_BASE_URL=https://freeipapi.com/api/json/
IPINFO_BASE_URL=https://api.ipinfo.io/lite
IPINFO_TIMEOUT_SECONDS=6
IPINFO_CACHE_TTL_SECONDS=3600
IPINFO_MAX_IPS_PER_SCAN=10
MAX_PAGE_SIZE_BYTES=1000000
MAX_REDIRECT_HOPS=5
PROVIDER_TIMEOUT_SECONDS=8
RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
RDAP_TIMEOUT_SECONDS=8
RDAP_MAX_REDIRECTS=3
CERTIFICATE_REVOCATION_TIMEOUT_SECONDS=6
CERTIFICATE_REVOCATION_CACHE_TTL_SECONDS=900
# Comma-separated SHA-256 certificate fingerprints from an authoritative distrust decision.
CERTIFICATE_DISTRUST_FINGERPRINTS=
CA_REPUTATION_FEED_URL=
CA_REPUTATION_FEED_TTL_SECONDS=21600
TLS_GRADING_TIMEOUT_SECONDS=5
TLS_MINIMUM_VERSION=TLSv1.2
TLS_MINIMUM_CIPHER_BITS=128
CERTIFICATE_RISK_WEIGHTS_JSON={}

# Production infrastructure (development defaults preserve the existing SQLite app).
ENVIRONMENT=development
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=10
REDIS_URL=
REDIS_NAMESPACE=digital-trust
REDIS_TIMEOUT_SECONDS=2
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_TIMEOUT_SECONDS=120
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
LLM_API_KEY=
LLM_MODEL=kimi-k3
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_TIMEOUT_SECONDS=30
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_READ_TIMEOUT_SECONDS=25
LLM_WRITE_TIMEOUT_SECONDS=10
LLM_POOL_TIMEOUT_SECONDS=5
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_OPEN_SECONDS=60
# Optional approved fallback. Keep empty unless privacy authorization is explicit.
LLM_SECONDARY_API_KEY=
LLM_SECONDARY_MODEL=
LLM_SECONDARY_BASE_URL=
LLM_SECONDARY_TIMEOUT_SECONDS=30
LLM_PRIMARY_PRIVACY_AUTHORIZED=true
LLM_SECONDARY_PRIVACY_AUTHORIZED=false
SMTP_CONTEXT_SHARED_SECRET=
SMTP_CONTEXT_MAX_AGE_SECONDS=86400
PHONE_REPUTATION_API_URL=
PHONE_REPUTATION_API_KEY=
PHONE_REPUTATION_AUTH_HEADER=Authorization
PHONE_REPUTATION_TIMEOUT_SECONDS=6
PHONE_REPUTATION_CACHE_TTL_SECONDS=900
PHONE_REPUTATION_MAX_RETRIES=2
PHONE_REPUTATION_PROVIDER=configured-phone-provider
IPQUALITYSCORE_API_KEY=
IPQUALITYSCORE_BASE_URL=https://ipqualityscore.com/api/json/phone
# Optional comma-separated additions; results remain UNKNOWN when no provider is configured.
DISPOSABLE_EMAIL_DOMAINS=
DNS_CACHE_TTL_SECONDS=300
DNS_TIMEOUT_SECONDS=4
